# Load credentials privately into the process environment. Never commit them.
# Required only when a selected LLM runner uses Vector.
VECTOR_KEY=
SOULX_GATEWAY_KEY=
SOULX_GATEWAY_URL=http://127.0.0.1:4000
SOULX_VAD_URL=ws://127.0.0.1:8000/turn
SOULX_TTS_URL=http://127.0.0.1:6006/tts
SOULX_SERVER_URL=ws://127.0.0.1:8765/v1/realtime
SOULX_RUN_DIR=./runs
# Hosted caller/judge keys are optional for local-caller inference.
# Select local callers and the Omni session runtime by default.
SOULX_CALLER_MODE=local
SOULX_FRONTEND_RUNTIME=sglang_omni
# Benchmark caller/judge keys belong to benchmark processes, not the agents.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional model routing and separate output group for a hosting configuration.
# SOULX_LLM_CONFIG=config/llm/local_frontend.yaml
# SOULX_OUTPUT_ROOT=/absolute/scratch/path/results/local_frontend
