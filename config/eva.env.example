# Export these privately for both EVA jobs. Run ID/domain/model under test are
# supplied by scripts.run_benchmark. Copy values into your private environment.
# Caller: recommended upstream ElevenLabs configuration.
EVA_USER_SIMULATOR__PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
EVA_EN_USER_F=
EVA_EN_USER_M=
OPENAI_API_KEY=
# Text judge example; audio judges additionally need Google/Gemini credentials.
JUDGE_MODEL=gpt-5.2
EVA_MODEL_LIST='[{"model_name":"gpt-5.2","litellm_params":{"model":"openai/gpt-5.2","api_key":"os.environ/OPENAI_API_KEY"}}]'
GOOGLE_APPLICATION_CREDENTIALS=
# EVA also accepts GOOGLE_API_KEY; configure the upstream audio judge accordingly.
# Alternative beta caller, when ElevenLabs agents have not been provisioned:
# EVA_USER_SIMULATOR__PROVIDER=openai_realtime
# EVA_USER_SIMULATOR__MODEL=gpt-realtime-1.5
